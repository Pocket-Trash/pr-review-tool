{
  "name": "@pocket-trash/pr-review-tool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/review.mjs",
    "./context": "./src/context.mjs",
    "./events": "./src/events.mjs",
    "./intake": "./src/intake.mjs",
    "./opencode": "./src/opencode.mjs"
  },
  "scripts": {
    "fixture": "node src/fixture.mjs test/fixtures/config.valid.json test/fixtures/review.valid.json test/fixtures/run.valid.json",
    "format:check": "npx --yes prettier@3.6.2 --check .",
    "review:local": "node src/local-review.mjs",
    "test": "node --test",
    "typecheck": "node --check src/*.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
